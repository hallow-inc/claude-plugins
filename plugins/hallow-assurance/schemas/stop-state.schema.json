{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assure.invalid/schemas/v0/stop-state.schema.json",
  "title": "Stop-hook retry state",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "blocks"],
  "properties": {
    "version": { "const": 1 },
    "blocks": { "type": "integer", "minimum": 0 },
    "fingerprints": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "blocks"],
        "properties": {
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "blocks": { "type": "integer", "minimum": 1, "maximum": 3 }
        }
      }
    }
  }
}
