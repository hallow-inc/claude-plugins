{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assure.invalid/schemas/v0/inspection.schema.json",
  "title": "Inspector findings (SARIF 2.1.0 profile)",
  "allOf": [
    { "$ref": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json" },
    { "$ref": "#/$defs/log" }
  ],
  "$defs": {
    "log": {
      "additionalProperties": false,
      "properties": {
        "$schema": true,
        "version": true,
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/run" }
        }
      }
    },
    "run": {
      "additionalProperties": false,
      "required": ["tool", "results"],
      "properties": {
        "tool": {
          "additionalProperties": false,
          "properties": {
            "driver": {
              "additionalProperties": false,
              "properties": {
                "name": { "const": "hallow-assurance:inspector" },
                "version": true,
                "informationUri": true,
                "rules": true
              }
            }
          }
        },
        "results": {
          "items": { "$ref": "#/$defs/result" }
        }
      }
    },
    "result": {
      "additionalProperties": false,
      "required": ["ruleId", "level", "message", "locations"],
      "properties": {
        "ruleId": { "minLength": 1 },
        "level": { "enum": ["error", "warning", "note"] },
        "message": {
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "minLength": 1 }
          }
        },
        "locations": {
          "minItems": 1,
          "items": { "$ref": "#/$defs/location" }
        }
      }
    },
    "location": {
      "additionalProperties": false,
      "required": ["physicalLocation"],
      "properties": {
        "physicalLocation": {
          "additionalProperties": false,
          "required": ["artifactLocation", "region"],
          "properties": {
            "artifactLocation": {
              "additionalProperties": false,
              "required": ["uri"],
              "properties": {
                "uri": { "$ref": "common.schema.json#/$defs/repoPath" }
              }
            },
            "region": {
              "additionalProperties": false,
              "required": ["startLine"],
              "properties": {
                "startLine": true,
                "startColumn": true,
                "endLine": true,
                "endColumn": true
              }
            }
          }
        }
      }
    }
  }
}
