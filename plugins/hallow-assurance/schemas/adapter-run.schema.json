{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assure.invalid/schemas/v0/adapter-run.schema.json",
  "title": "Adapter run response",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "evidence", "tool_versions", "pinned_by"],
  "properties": {
    "protocol": { "$ref": "common.schema.json#/$defs/protocolV1" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path"],
        "properties": {
          "type": { "$ref": "common.schema.json#/$defs/evidenceType" },
          "path": { "$ref": "common.schema.json#/$defs/repoPath" }
        }
      }
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
    },
    "pinned_by": {
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
    },
    "environment": { "$ref": "common.schema.json#/$defs/environment" }
  },
  "if": { "required": ["environment"] },
  "then": {
    "properties": { "evidence": { "maxItems": 0 } }
  },
  "else": {
    "properties": { "tool_versions": { "minProperties": 1 } }
  }
}
