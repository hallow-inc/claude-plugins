#!/bin/sh
expected=2
event=$1

dir=$PWD
while [ ! -f "$dir/assurance.yaml" ]; do
  [ "$dir" = / ] && exit 0
  dir=$(dirname "$dir")
done

unavailable() {
  if [ "$event" = stop ] || [ "$event" = subagent-stop ]; then
    printf '{"systemMessage":"assure-hook: the %s check did not run. %s"}\n' "$event" "$2"
    exit 0
  fi
  echo "assure-hook: $1" >&2
  exit 2
}

version=$(sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([^"]*\)".*/\1/p' "$(dirname "$0")/../.claude-plugin/plugin.json" 2>/dev/null)
case $version in
  '' | *[!0-9.]* | .* | *. | *..* | *.*.*.*) version= ;;
  *.*.*) ;;
  *) version= ;;
esac
if [ -n "$version" ]; then
  install="Install it with: go install github.com/hallow-inc/claude-plugins/plugins/hallow-assurance/...@v$version"
else
  install="The plugin version could not be read from plugin.json; install assure as the hallow-assurance plugin README describes."
fi

if ! command -v assure >/dev/null 2>&1; then
  unavailable "$dir/assurance.yaml adopts hallow-assurance, but assure is not on PATH. $install" "assure is not on PATH. $install"
fi

got=$(assure hook protocol 2>/dev/null)
if [ "$got" != "$expected" ]; then
  shown=$got
  case $shown in '' | *[!0-9]*) shown=unknown ;; esac
  unavailable "this plugin speaks hook protocol $expected, but the assure on PATH prints '$got'. $install" \
    "This plugin speaks hook protocol $expected, but the assure on PATH speaks $shown. $install"
fi

exec assure hook "$event"
