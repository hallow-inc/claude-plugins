  "objectives": [
    {"objective": "VER-COVERAGE-RESOLUTION", "language": "python", "status": "pass"},
    {"objective": "VER-MUTATION-CHANGED", "language": "python", "status": "pass"},
    {"objective": "VER-TESTS-PASS", "language": "python", "status": "fail", "locations": ["failing test: tests/test_double.py.test_double_flaky"]}
  ]
