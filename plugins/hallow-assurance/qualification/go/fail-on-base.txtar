VER-FAIL-ON-BASE: a fix commit whose only test, TestDoubleTwo, calls Double as it exists on
base and passes there, so it cannot show the fix.

-- base/assurance.yaml --
version: 0
catalog: v0
languages: [go]
default_level: B
components:
  - path: p/**
    level: B
-- base/go.mod --
module example.com/q

go 1.27
-- base/p/p.go --
package p

func Double(x int) int { return 2 * x }
-- head/p/p_test.go --
package p

import "testing"

func TestDoubleTwo(t *testing.T) {
	if got := Double(2); got != 4 {
		t.Fatalf("Double(2) = %d, want 4", got)
	}
}
-- head.msg --
fix(p): double correctly
-- expect.json --
{
  "objectives": [
    {"objective": "VER-COVERAGE-RESOLUTION", "language": "go", "status": "pass"},
    {"objective": "VER-FAIL-ON-BASE", "language": "go", "status": "fail", "locations": ["passes on base: p.TestDoubleTwo"]},
    {"objective": "VER-MUTATION-CHANGED", "language": "go", "status": "pass"},
    {"objective": "VER-TESTS-PASS", "language": "go", "status": "pass"}
  ]
}
