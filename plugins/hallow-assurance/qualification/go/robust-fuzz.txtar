VER-ROBUST-FUZZ: in the inputs component p, the seed "" makes First index an empty string.
go test runs fuzz seeds too, so VER-TESTS-PASS fails on the same panic.

-- base/assurance.yaml --
version: 0
catalog: v0
languages: [go]
default_level: B
components:
  - path: p/**
    level: B
    inputs: true
-- base/go.mod --
module example.com/q

go 1.27
-- base/p/p.go --
package p

func Double(x int) int { return 2 * x }
-- head/p/first.go --
package p

func First(s string) byte {
	return s[0]
}
-- head/p/first_test.go --
package p

import "testing"

func FuzzFirst(f *testing.F) {
	f.Add("a")
	f.Add("")
	f.Fuzz(func(t *testing.T, s string) {
		if First(s) != s[0] {
			t.Fatal("First disagrees with s[0]")
		}
	})
}
-- head.msg --
feat(p): add First
