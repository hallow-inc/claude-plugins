package p

func Double(x int) int { return 2 * x }
-- head/p/counter.go --
package p

import "sync"

type Counter struct {
	sync.Mutex
	N int
}

func Snapshot(c Counter) int {
	return c.N
}
-- head/p/counter_test.go --
package p

import "testing"

func TestSnapshot(t *testing.T) {
	if got := Snapshot(Counter{N: 3}); got != 3 {
		t.Fatalf("Snapshot = %d, want 3", got)
	}
}
-- head.msg --
feat(p): add Counter
