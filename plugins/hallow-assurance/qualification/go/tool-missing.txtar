Missing tool: golangci-lint is absent from PATH. The change itself is clean, so only the
objectives that need golangci-lint fail, each with a detail naming it.

-- base/assurance.yaml --
version: 0
catalog: v0
languages: [go]
default_level: B
components:
  - path: p/**
    level: B
-- base/go.mod --
module example.com/q

go 1.27
-- base/p/p.go --
package p

func Double(x int) int { return 2 * x }
-- head/p/p_test.go --
package p

import "testing"

func TestDouble(t *testing.T) {
	if got := Double(3); got != 6 {
		t.Fatalf("Double(3) = %d, want 6", got)
	}
}
-- omit-tools --
golangci-lint
-- head.msg --
test(p): cover Double
-- expect.json --
{
  "objectives": [
    {"objective": "CFG-PROTECTED", "status": "pass"},
    {"objective": "CODE-CHECK-RETURNS", "language": "go", "status": "fail", "locations": ["golangci-lint: golangci-lint is not on PATH"]},
    {"objective": "CODE-COMPLEXITY", "language": "go", "status": "pass"},
    {"objective": "CODE-NO-UNSAFE", "language": "go", "status": "pass"},
    {"objective": "CODE-RESOURCE-BOUNDS", "language": "go", "status": "fail", "locations": ["golangci-lint: golangci-lint is not on PATH"]},
    {"objective": "CODE-ZERO-WARNINGS", "language": "go", "status": "fail", "locations": ["golangci-lint: golangci-lint is not on PATH"]},
    {"objective": "VER-COVERAGE-RESOLUTION", "language": "go", "status": "pass"},
    {"objective": "VER-MUTATION-CHANGED", "language": "go", "status": "pass"},
    {"objective": "VER-TESTS-PASS", "language": "go", "status": "pass"}
  ]
