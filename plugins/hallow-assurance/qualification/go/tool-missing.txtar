Missing tool: gremlins is absent from PATH. The change itself is clean, so only the objective
that needs gremlins fails, with a detail naming it.

-- base/assurance.yaml --
version: 0
catalog: v0
languages: [go]
default_level: B
components:
  - path: p/**
    level: B
-- base/go.mod --
module example.com/q

go 1.27
-- base/p/p.go --
package p

func Double(x int) int { return 2 * x }
-- head/p/p_test.go --
package p

import "testing"

func TestDouble(t *testing.T) {
	if got := Double(3); got != 6 {
		t.Fatalf("Double(3) = %d, want 6", got)
	}
}
-- omit-tools --
gremlins
-- head.msg --
test(p): cover Double
