package p

func Double(x int) int { return 2 * x }
-- head/p/code.go --
package p

func Code(s string) string {
	switch s {
	case "a":
		return "A"
	case "b":
		return "B"
	case "c":
		return "C"
	case "d":
		return "D"
	case "e":
		return "E"
	case "f":
		return "F"
	case "g":
		return "G"
	case "h":
		return "H"
	case "i":
		return "I"
	case "j":
		return "J"
	case "k":
		return "K"
	case "l":
		return "L"
	case "m":
		return "M"
	case "n":
		return "N"
	case "o":
		return "O"
	}
	return "?"
}
-- head/p/code_test.go --
package p

import (
	"strings"
	"testing"
)

func TestCode(t *testing.T) {
	for _, s := range strings.Split("abcdefghijklmno", "") {
		if got := Code(s); got != strings.ToUpper(s) {
			t.Errorf("Code(%q) = %q", s, got)
		}
	}
	if got := Code("z"); got != "?" {
		t.Errorf("Code(z) = %q", got)
	}
}
-- head.msg --
feat(p): add Code
