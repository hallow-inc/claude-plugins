-- base/go.mod --
module example.com/q

go 1.27
-- base/p/p.go --
package p

func Double(x int) int { return 2 * x }
-- head/p/size.go --
package p

import "unsafe"

func WordSize() uintptr {
	return unsafe.Sizeof(int64(0))
}
-- head/p/size_test.go --
package p

import "testing"

func TestWordSize(t *testing.T) {
	if got := WordSize(); got != 8 {
		t.Fatalf("WordSize = %d, want 8", got)
	}
}
-- head.msg --
feat(p): add WordSize
