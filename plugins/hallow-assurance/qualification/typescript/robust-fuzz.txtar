VER-ROBUST-FUZZ: in the inputs component src, the fast-check example "" makes initial index an
empty string and throw. The fuzz file ends in .test.ts, so VER-TESTS-PASS fails on the same
property, and Stryker refuses to mutate when its initial test run fails, so VER-MUTATION-CHANGED
fails with the adapter's run error.

-- deps --
full
-- base/assurance.yaml --
version: 0
catalog: v0
languages: [typescript]
default_level: B
components:
  - path: src/**
    level: B
    inputs: true
-- base/.gitignore --
node_modules
-- base/tsconfig.json --
{ "compilerOptions": { "strict": true, "module": "esnext", "moduleResolution": "bundler", "target": "es2022", "noEmit": true, "types": [] }, "include": ["src"] }
-- base/vitest.config.ts --
import { defineConfig } from "vitest/config";

export default defineConfig({ test: { setupFiles: ["./vitest.setup.ts"] } });
-- base/vitest.setup.ts --
import fc from "fast-check";

const seed = Number(process.env.ASSURE_SEED);
if (Number.isInteger(seed)) {
  fc.configureGlobal({ ...fc.readConfigureGlobal(), seed });
}
-- base/src/double.ts --
export function double(x: number): number {
  return 2 * x;
}
-- head/src/initial.ts --
export function initial(name: string): string {
  return name.split(" ")[0][0].toUpperCase();
}
-- head/src/initial.fuzz.test.ts --
import fc from "fast-check";
import { test } from "vitest";
import { initial } from "./initial";

test("initial never throws", () => {
  fc.assert(
    fc.property(fc.string(), (name) => {
      initial(name);
    }),
    { examples: [["ada lovelace"], [""]] },
  );
});
-- head.msg --
feat(src): add initial
-- expect.json --
{
  "objectives": [
    {"objective": "CFG-PROTECTED", "status": "pass"},
    {"objective": "VER-COVERAGE-RESOLUTION", "language": "typescript", "status": "pass"},
    {"objective": "VER-MUTATION-CHANGED", "language": "typescript", "status": "fail", "locations": ["assure-adapter-typescript run: exit status 1; stderr: assure-adapter-typescript: run VER-MUTATION-CHANGED: stryker run in .: exit status 1"]},
    {"objective": "VER-ROBUST-FUZZ", "language": "typescript", "status": "fail", "locations": ["src/initial.ts: fuzz target src/initial.fuzz.test.ts.initial never throws failed"]},
    {"objective": "VER-TESTS-PASS", "language": "typescript", "status": "fail", "locations": ["failing test: src/initial.fuzz.test.ts.initial never throws"]}
  ]
