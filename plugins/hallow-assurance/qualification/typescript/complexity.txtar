-- head/src/code.ts --
export function code(s: string): string {
  switch (s) {
    case "a":
      return "A";
    case "b":
      return "B";
    case "c":
      return "C";
    case "d":
      return "D";
    case "e":
      return "E";
    case "f":
      return "F";
    case "g":
      return "G";
    case "h":
      return "H";
    case "i":
      return "I";
    case "j":
      return "J";
    case "k":
      return "K";
    case "l":
      return "L";
    case "m":
      return "M";
    case "n":
      return "N";
    case "o":
      return "O";
  }
  return "?";
}
-- head/src/code.test.ts --
import { expect, test } from "vitest";
import { code } from "./code";

test("code upper-cases a to o and maps anything else to ?", () => {
  for (const s of "abcdefghijklmno") {
    expect(code(s)).toBe(s.toUpperCase());
  }
  expect(code("z")).toBe("?");
});
