-- base/vitest.config.ts --
import { defineConfig } from "vitest/config";

export default defineConfig({ test: { setupFiles: ["./vitest.setup.ts"] } });
-- base/vitest.setup.ts --
import fc from "fast-check";

const seed = Number(process.env.ASSURE_SEED);
if (Number.isInteger(seed)) {
  fc.configureGlobal({ ...fc.readConfigureGlobal(), seed });
}
-- base/src/double.ts --
export function double(x: number): number {
  return 2 * x;
}
-- head/src/log.ts --
export async function append(log: string[], line: string): Promise<void> {
  log.push(line);
}

export function record(log: string[], line: string): void {
  append(log, line);
}
-- head/src/log.test.ts --
import { expect, test } from "vitest";
import { record } from "./log";

test("record appends the line", () => {
  const log: string[] = [];
  record(log, "a");
  expect(log).toEqual(["a"]);
});
-- head.msg --
feat(src): add record
