VER-FAIL-ON-BASE: a fix commit whose only test, "double of 2 is 4", calls double as it exists on
base and passes there, so it cannot show the fix.

-- deps --
full
-- base/assurance.yaml --
version: 0
catalog: v0
languages: [typescript]
default_level: B
components:
  - path: src/**
    level: B
-- base/.gitignore --
node_modules
-- base/tsconfig.json --
{ "compilerOptions": { "strict": true, "module": "esnext", "moduleResolution": "bundler", "target": "es2022", "noEmit": true, "types": [] }, "include": ["src"] }
-- base/eslint.config.js --
import tseslint from "typescript-eslint";

export default tseslint.config(tseslint.configs.recommended);
-- base/vitest.config.ts --
import { defineConfig } from "vitest/config";

export default defineConfig({ test: { setupFiles: ["./vitest.setup.ts"] } });
-- base/vitest.setup.ts --
import fc from "fast-check";

const seed = Number(process.env.ASSURE_SEED);
if (Number.isInteger(seed)) {
  fc.configureGlobal({ ...fc.readConfigureGlobal(), seed });
}
-- base/src/double.ts --
export function double(x: number): number {
  return 2 * x;
}
-- head/src/double.test.ts --
import { expect, test } from "vitest";
import { double } from "./double";

test("double of 2 is 4", () => {
  expect(double(2)).toBe(4);
});
-- head.msg --
fix(src): double correctly

Assure-Kind: fix
-- expect.json --
