    {"objective": "CODE-NO-UNSAFE", "language": "typescript", "status": "pass"},
    {"objective": "CODE-RESOURCE-BOUNDS", "language": "typescript", "status": "pass"},
    {"objective": "CODE-ZERO-WARNINGS", "language": "typescript", "status": "pass"},
    {"objective": "VER-COVERAGE-RESOLUTION", "language": "typescript", "status": "pass"},
    {"objective": "VER-FAIL-ON-BASE", "language": "typescript", "status": "fail", "locations": ["passes on base: src/double.test.ts.double of 2 is 4"]},
    {"objective": "VER-MUTATION-CHANGED", "language": "typescript", "status": "pass"},
    {"objective": "VER-TESTS-PASS", "language": "typescript", "status": "pass"}
