-- base/vitest.setup.ts --
import fc from "fast-check";

const seed = Number(process.env.ASSURE_SEED);
if (Number.isInteger(seed)) {
  fc.configureGlobal({ ...fc.readConfigureGlobal(), seed });
}
-- base/src/digits.ts --
export function digitSum(s: string): number {
  if (s === "") {
    throw new RangeError("empty input");
  }
  let n = 0;
  for (const c of s) {
    if (c < "0" || c > "8") {
      throw new RangeError("not a digit");
    }
    n += c.charCodeAt(0) - 48;
  }
  return n;
}
-- base/src/digits.fuzz.test.ts --
import fc from "fast-check";
import { test } from "vitest";
import { digitSum } from "./digits";

test("digitSum stays in range or throws RangeError", () => {
  fc.assert(
    fc.property(fc.string(), (s) => {
      try {
        const n = digitSum(s);
        if (n < 0 || n > 9 * s.length) {
          throw new Error(`digitSum(${JSON.stringify(s)}) = ${n} out of range`);
        }
      } catch (e) {
        if (!(e instanceof RangeError)) {
          throw e;
        }
      }
    }),
    { examples: [[""], ["123"], ["x"]] },
  );
});
-- head/src/digits.ts --
export function digitSum(s: string): number {
  if (s === "") {
    throw new RangeError("empty input");
  }
  let n = 0;
  for (const c of s) {
    if (c < "0" || c > "9") {
      throw new RangeError("not a digit");
    }
    n += c.charCodeAt(0) - 48;
  }
  return n;
}
-- head/src/digits.test.ts --
import { expect, test } from "vitest";
import { digitSum } from "./digits";

test("digitSum accepts the digit 9 and rejects everything outside 0-9", () => {
  expect(digitSum("0")).toBe(0);
  expect(digitSum("9")).toBe(9);
  expect(digitSum("09")).toBe(9);
  expect(digitSum("123")).toBe(6);
  for (const bad of ["", "/", ":", "1a"]) {
    expect(() => digitSum(bad)).toThrow(RangeError);
  }
});
-- head.msg --
fix(src): accept the digit 9
