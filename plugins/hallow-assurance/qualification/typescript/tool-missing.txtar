Missing tool: the no-stryker dependency set omits @stryker-mutator/core, and
@stryker-mutator/vitest-runner with it (npm installs peer dependencies, so keeping the runner would
install the core). The change itself is clean, so only the objective that needs
@stryker-mutator/core fails, with a detail naming it.

-- deps --
no-stryker
-- base/assurance.yaml --
version: 0
catalog: v0
languages: [typescript]
default_level: B
components:
  - path: src/**
    level: B
-- base/.gitignore --
node_modules
-- base/tsconfig.json --
{ "compilerOptions": { "strict": true, "module": "esnext", "moduleResolution": "bundler", "target": "es2022", "noEmit": true, "types": [] }, "include": ["src"] }
-- base/vitest.config.ts --
import { defineConfig } from "vitest/config";

export default defineConfig({ test: { setupFiles: ["./vitest.setup.ts"] } });
-- base/vitest.setup.ts --
import fc from "fast-check";

const seed = Number(process.env.ASSURE_SEED);
if (Number.isInteger(seed)) {
  fc.configureGlobal({ ...fc.readConfigureGlobal(), seed });
}
-- base/src/double.ts --
export function double(x: number): number {
  return 2 * x;
}
-- head/src/double.test.ts --
import { expect, test } from "vitest";
import { double } from "./double";

test("double of 3 is 6", () => {
  expect(double(3)).toBe(6);
});
-- head.msg --
test(src): cover double
-- expect.json --
{
  "objectives": [
    {"objective": "CFG-PROTECTED", "status": "pass"},
    {"objective": "VER-COVERAGE-RESOLUTION", "language": "typescript", "status": "pass"},
    {"objective": "VER-MUTATION-CHANGED", "language": "typescript", "status": "fail", "locations": ["@stryker-mutator/core: not installed in node_modules of . or any parent up to the git top-level"]},
    {"objective": "VER-TESTS-PASS", "language": "typescript", "status": "pass"}
  ]
}
