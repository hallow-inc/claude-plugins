Missing tool: the no-eslint dependency set omits eslint, and typescript-eslint with it (npm
installs peer dependencies, so keeping typescript-eslint would install eslint). The change itself
is clean, so only the objectives that need eslint fail, each with a detail naming it.

-- deps --
no-eslint
-- base/assurance.yaml --
version: 0
catalog: v0
languages: [typescript]
default_level: B
components:
  - path: src/**
    level: B
-- base/.gitignore --
node_modules
-- base/tsconfig.json --
{ "compilerOptions": { "strict": true, "module": "esnext", "moduleResolution": "bundler", "target": "es2022", "noEmit": true, "types": [] }, "include": ["src"] }
-- base/eslint.config.js --
import tseslint from "typescript-eslint";

export default tseslint.config(tseslint.configs.recommended);
-- base/vitest.config.ts --
import { defineConfig } from "vitest/config";

export default defineConfig({ test: { setupFiles: ["./vitest.setup.ts"] } });
-- base/vitest.setup.ts --
import fc from "fast-check";

const seed = Number(process.env.ASSURE_SEED);
if (Number.isInteger(seed)) {
  fc.configureGlobal({ ...fc.readConfigureGlobal(), seed });
}
-- base/src/double.ts --
export function double(x: number): number {
  return 2 * x;
}
-- head/src/double.test.ts --
import { expect, test } from "vitest";
import { double } from "./double";

test("double of 3 is 6", () => {
  expect(double(3)).toBe(6);
});
-- head.msg --
test(src): cover double
-- expect.json --
{
  "objectives": [
    {"objective": "CFG-PROTECTED", "status": "pass"},
    {"objective": "CODE-CHECK-RETURNS", "language": "typescript", "status": "fail", "locations": ["eslint: not installed in node_modules of . or any parent up to the git top-level"]},
    {"objective": "CODE-COMPLEXITY", "language": "typescript", "status": "fail", "locations": ["eslint: not installed in node_modules of . or any parent up to the git top-level"]},
    {"objective": "CODE-NO-UNSAFE", "language": "typescript", "status": "fail", "locations": ["eslint: not installed in node_modules of . or any parent up to the git top-level"]},
    {"objective": "CODE-RESOURCE-BOUNDS", "language": "typescript", "status": "fail", "locations": ["eslint: not installed in node_modules of . or any parent up to the git top-level"]},
    {"objective": "CODE-ZERO-WARNINGS", "language": "typescript", "status": "fail", "locations": ["eslint: not installed in node_modules of . or any parent up to the git top-level"]},
    {"objective": "VER-COVERAGE-RESOLUTION", "language": "typescript", "status": "pass"},
    {"objective": "VER-MUTATION-CHANGED", "language": "typescript", "status": "pass"},
    {"objective": "VER-TESTS-PASS", "language": "typescript", "status": "pass"}
  ]
}
