-- head/src/status.ts --
export async function status(url: string): Promise<number> {
  const res = await fetch(url);
  return res.status;
}
-- head/src/status.test.ts --
import { afterEach, expect, test, vi } from "vitest";
import { status } from "./status";

afterEach(() => {
  vi.unstubAllGlobals();
});

test("status returns the response status", async () => {
  vi.stubGlobal("fetch", async () => new Response(null, { status: 418 }));
  await expect(status("http://example.invalid/")).resolves.toBe(418);
});
-- head.msg --
feat(src): add status
