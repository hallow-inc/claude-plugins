-- head/src/clamp.ts --
export function clamp(x: number, lo: number, hi: number): number {
  if (x < lo) {
    return lo;
  }
  if (x > hi) {
    return hi;
  }
  return x;
}
-- head/src/clamp.test.ts --
import { test } from "vitest";
import { clamp } from "./clamp";

test("clamp runs", () => {
  for (const x of [-1, 0, 5, 10, 11]) {
    clamp(x, 0, 10);
  }
});
